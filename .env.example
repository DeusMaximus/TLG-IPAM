# Copy to .env and replace the placeholder with a real key, e.g. `openssl rand -hex 32`.
# The server will not start while API_KEY is unset, empty, `change-me`, or has a space,
# tab or newline at either end.
API_KEY=change-me

# Remote MCP, for web AI assistants. Leave PUBLIC_BASE_URL unset to keep it off, and
# read docs/deployment.md first: it says which paths to publish and which to keep private.
# The value is the server's public origin and nothing else: https://, a lowercase host
# name, a port only when it is not 443, no path and no trailing slash.
# PUBLIC_BASE_URL=https://ipam.example.com

# Whether a link may be allowed to make changes. false (the default): every link is
# read-only.
# MCP_REMOTE_WRITES=false

# Behind a reverse proxy or tunnel, and only if the server's log shows the proxy's
# address instead of the client's: the proxy's address as the log shows it. Never `*`
# unless only the proxy can reach port 8080.
# UVICORN_FORWARDED_ALLOW_IPS=172.18.0.1
